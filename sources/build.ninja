    ../fonts/variable/Anvers-Italic[wght].ttf | $
    ../fonts/variable/Anvers-Italic-Italic[wght].ttf
  stamp =  && touch $
      /var/folders/gq/g2r9xykn4dd7hy3_gdvvc69r0000gn/T/tmpjsu1ifzb.buildStatstamp
  postprocess = buildStat
  args = --src /var/folders/gq/g2r9xykn4dd7hy3_gdvvc69r0000gn/T/tmp0n1n1k29
