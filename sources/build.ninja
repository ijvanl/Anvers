# Postprocessing  with BuildSTAT
build $
    /var/folders/gq/g2r9xykn4dd7hy3_gdvvc69r0000gn/T/tmpld_rnpwn.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/Anvers[wght].ttf | $
    ../fonts/variable/Anvers-Italic[wght].ttf
  stamp =  && touch $
      /var/folders/gq/g2r9xykn4dd7hy3_gdvvc69r0000gn/T/tmpld_rnpwn.buildStatstamp
  postprocess = buildStat
  args = --src /var/folders/gq/g2r9xykn4dd7hy3_gdvvc69r0000gn/T/tmplw4vcamx
